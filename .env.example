# YouTube Data API v3 Key for Live Ingestion Mode
YOUTUBE_API_KEY=your_real_youtube_api_key_here

# Meta Graph API configuration for Facebook/Instagram Ingestion Scaffolds
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_access_token_here

# Telegram MTProto API configuration (obtain from my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Telegram channels to monitor — optional seed channels (comma-separated, with or without '@').
# When SOCIAL_AUTO_DISCOVERY=true (default) and empty, the crawler searches keyword-driven
# across all channels the authenticated session account has already joined.
# When provided, these channels are joined first to expand the searchable dialog set.
# Example: TELEGRAM_CHANNELS=gujaratsamacharofficial,divyabhaskar,SandeshNewsOfficial
TELEGRAM_CHANNELS=

# Facebook pages — optional seed page IDs/slugs (comma-separated).
# When SOCIAL_AUTO_DISCOVERY=true (default), the crawler also attempts to auto-discover
# relevant pages via keyword search (requires 'pages_search' permission on the token).
# Seeds are merged with any auto-discovered pages; neither disables the other.
# Example: FACEBOOK_PAGES=GujaratSamachar,divyabhaskar
FACEBOOK_PAGES=

# ── Social Crawler Discovery Controls ─────────────────────────────────────────
# SOCIAL_AUTO_DISCOVERY: set to 'false' to disable all automatic source discovery
#   and rely only on manually specified seeds (TELEGRAM_CHANNELS / FACEBOOK_PAGES).
SOCIAL_AUTO_DISCOVERY=true

# SOCIAL_SOURCE_MODE: 'auto' (default) discovers sources, then merges with seeds.
#   'manual' uses ONLY the manually specified seed lists; auto-discovery is skipped.
SOCIAL_SOURCE_MODE=auto

# ENABLE_TELEGRAM: set to 'false' to completely disable the Telegram crawler.
ENABLE_TELEGRAM=true

# ENABLE_FACEBOOK: set to 'false' to completely disable the Facebook crawler.
ENABLE_FACEBOOK=true

# Neo4j Graph Database configuration (AuraDB)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# X (Twitter) API v2 Bearer Token (requires paid API tier credit balance; no free tier available as of Feb 2026)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Google Gemini API Key for data-aware assistant chatbox (free tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
